# =============================================================================
# Environment Variables for Physical AI & Humanoid Robotics Textbook Frontend
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI ChatKit Configuration (Frontend UI Only)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_...

# -----------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Get your connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Better Auth Configuration
# -----------------------------------------------------------------------------
# Secret key for signing sessions and tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-here

# Base URL for authentication callbacks and redirects
# Use http://localhost:3000 for local development
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OAuth Providers (Optional)
# -----------------------------------------------------------------------------
# Google OAuth - Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - Create OAuth app at https://github.com/settings/developers
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Backend & API Configuration (use env to switch local vs hosted without code changes)
# -----------------------------------------------------------------------------
# Base URL of the FastAPI RAG chatbot backend. Used by chat UI and /api/chat proxy.
# Local: http://localhost:8000  |  Hosted: https://your-space.hf.space
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: override API base URL if different from backend (defaults to BACKEND_URL)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Textbook (Docusaurus) URL for the /book iframe and links.
# Local: http://localhost:3001/humanoid-and-robotic-book  |  Hosted: https://your-org.github.io/humanoid-and-robotic-book
NEXT_PUBLIC_BOOK_URL=http://localhost:3001/humanoid-and-robotic-book
